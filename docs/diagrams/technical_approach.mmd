flowchart TB
  %% Styles
  classDef client fill:#E3F2FD,stroke:#1E88E5,stroke-width:2px,color:#0D47A1
  classDef api fill:#E8F5E9,stroke:#43A047,stroke-width:2px,color:#1B5E20
  classDef logic fill:#FFF3E0,stroke:#FB8C00,stroke-width:2px,color:#E65100
  classDef data fill:#F3E5F5,stroke:#8E24AA,stroke-width:2px,color:#4A148C
  classDef sec fill:#FFEBEE,stroke:#E53935,stroke-width:2px,color:#B71C1C

  subgraph Client [Client - React + TypeScript]
    C1[UI Components]
    C2[State and Context]
    C3[Routing - Protected]
  end
  class C1,C2,C3 client

  subgraph API [API - Node.js + Express]
    A1[Routes]
    A2[Controllers]
    A3[Middleware]
  end
  class A1,A2,A3 api

  subgraph Logic [Domain Logic]
    L1[Validation]
    L2[Record Management]
    L3[PDF Generation]
  end
  class L1,L2,L3 logic

  subgraph Data [Data - MongoDB + Mongoose]
    D1[Models]
    D2[Indexes]
    D3[Aggregation]
  end
  class D1,D2,D3 data

  subgraph Security [Security]
    S1[JWT Auth]
    S2[bcrypt Passwords]
    S3[OTP - time bound]
  end
  class S1,S2,S3 sec

  C1 --> A1
  C2 --> A1
  C3 --> A3

  A1 --> A2 --> L1
  L1 --> L2 --> D1
  D1 --> D2
  D1 --> D3

  A2 --> L3

  A3 --> S1
  A3 --> S2
  A3 --> S3
